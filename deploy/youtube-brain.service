# User unit. Install with the timer:
#   cp deploy/youtube-brain.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now youtube-brain.timer
#   loginctl enable-linger $USER   # so it runs while you're logged out
[Unit]
Description=Summarize the YouTube Digest playlist

[Service]
Type=oneshot
ExecStart=%h/go/bin/youtube-brain run
